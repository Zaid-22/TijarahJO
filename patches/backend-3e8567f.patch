diff --git a/TijarahJoDBAPI/TijarahJoDBAPI/Services/PostsFeedService.cs b/TijarahJoDBAPI/TijarahJoDBAPI/Services/PostsFeedService.cs
new file mode 100644
index 0000000..e6af336
--- /dev/null
+++ b/TijarahJoDBAPI/TijarahJoDBAPI/Services/PostsFeedService.cs
@@ -0,0 +1,276 @@
+using Microsoft.Data.SqlClient;
+using System.Globalization;
+using System.Text.Json.Serialization;
+using TijarahJoDB_DataAccess;
+
+namespace TijarahJoDBAPI.Services
+{
+    public sealed class PostsFeedService
+    {
+        private const string ClientStatusSql =
+            "CASE WHEN p.IsDeleted = 1 OR p.Status IN (1, 2) THEN 'DELETED' WHEN p.Status = 3 THEN 'SOLD' ELSE 'ACTIVE' END";
+
+        public sealed record NormalizedFeedRequest(int Page, int Limit, bool IncludeDeleted);
+
+        public NormalizedFeedRequest NormalizeRequest(
+            int? page,
+            int? limit,
+            bool? includeDeleted
+        )
+        {
+            int normalizedPage = page.GetValueOrDefault(1);
+            if (normalizedPage < 1)
+            {
+                normalizedPage = 1;
+            }
+
+            int normalizedLimit = limit.GetValueOrDefault(20);
+            if (normalizedLimit < 1)
+            {
+                normalizedLimit = 20;
+            }
+            if (normalizedLimit > 500)
+            {
+                normalizedLimit = 500;
+            }
+
+            bool normalizedIncludeDeleted = includeDeleted.GetValueOrDefault(false);
+            return new NormalizedFeedRequest(normalizedPage, normalizedLimit, normalizedIncludeDeleted);
+        }
+
+        public FeedResponse FetchPostsFeed(NormalizedFeedRequest request)
+        {
+            int offset = (request.Page - 1) * request.Limit;
+
+            string sql = $@"
+WITH FeedPosts AS
+(
+	SELECT
+		p.PostID,
+		p.UserID,
+		p.CategoryID,
+		ISNULL(p.PostTitle, '') AS PostTitle,
+		ISNULL(p.PostDescription, '') AS PostDescription,
+		ISNULL(p.Price, 0) AS Price,
+		p.CreatedAt,
+		ISNULL(p.Views, 0) AS Views,
+		ISNULL(p.City, '') AS City,
+		ISNULL(p.Area, '') AS Area,
+		ISNULL(c.CategoryName, '') AS CategoryName,
+		COALESCE(
+			NULLIF(LTRIM(RTRIM(CONCAT(ISNULL(u.FirstName, ''), ' ', ISNULL(u.LastName, '')))), ''),
+			NULLIF(u.Email, ''),
+			CONCAT('User ', p.UserID)
+		) AS SellerName,
+		ISNULL(img.ImageURLs, '') AS ImageURLs,
+		{ClientStatusSql} AS ClientStatus
+	FROM dbo.TbPosts AS p
+	LEFT JOIN dbo.TbItemCategories AS c ON c.CategoryID = p.CategoryID
+	LEFT JOIN dbo.TbUsers AS u ON u.UserID = p.UserID
+	OUTER APPLY
+	(
+		SELECT STRING_AGG(pi.PostImageURL, ',') AS ImageURLs
+		FROM dbo.TbPostImages AS pi
+		WHERE pi.PostID = p.PostID
+		  AND ISNULL(pi.IsDeleted, 0) = 0
+	) AS img
+	WHERE (@IncludeDeleted = 1 OR p.IsDeleted = 0)
+)
+SELECT
+	fp.PostID,
+	fp.UserID,
+	fp.CategoryID,
+	fp.PostTitle,
+	fp.PostDescription,
+	fp.Price,
+	fp.City,
+	fp.Area,
+	fp.SellerName,
+	fp.CategoryName,
+	fp.CreatedAt,
+	fp.Views,
+	fp.ClientStatus,
+	fp.ImageURLs,
+	COUNT(1) OVER() AS TotalCount
+FROM FeedPosts AS fp
+ORDER BY fp.CreatedAt DESC, fp.PostID DESC
+OFFSET @Offset ROWS FETCH NEXT @Limit ROWS ONLY;";
+
+            using SqlConnection connection = new SqlConnection(clsDataAccessSettings.ConnectionString);
+            using SqlCommand command = new SqlCommand(sql, connection);
+            command.Parameters.AddWithValue("@IncludeDeleted", request.IncludeDeleted);
+            command.Parameters.AddWithValue("@Offset", offset);
+            command.Parameters.AddWithValue("@Limit", request.Limit);
+
+            connection.Open();
+
+            List<FeedPostItem> posts = new List<FeedPostItem>();
+            int totalPosts = 0;
+
+            using SqlDataReader reader = command.ExecuteReader();
+            while (reader.Read())
+            {
+                int postId = reader.GetInt32(reader.GetOrdinal("PostID"));
+                int userId = reader.GetInt32(reader.GetOrdinal("UserID"));
+                int categoryId = reader.GetInt32(reader.GetOrdinal("CategoryID"));
+                string postTitle = reader.GetString(reader.GetOrdinal("PostTitle"));
+                string postDescription = reader.GetString(reader.GetOrdinal("PostDescription"));
+                decimal price = reader.GetDecimal(reader.GetOrdinal("Price"));
+                string city = reader.GetString(reader.GetOrdinal("City"));
+                string area = reader.GetString(reader.GetOrdinal("Area"));
+                string sellerName = reader.GetString(reader.GetOrdinal("SellerName"));
+                string categoryName = reader.GetString(reader.GetOrdinal("CategoryName"));
+                DateTime createdAt = reader.GetDateTime(reader.GetOrdinal("CreatedAt"));
+                int views = reader.GetInt32(reader.GetOrdinal("Views"));
+                string status = reader.GetString(reader.GetOrdinal("ClientStatus"));
+                string imageCsv = reader.GetString(reader.GetOrdinal("ImageURLs"));
+
+                int totalCount = reader.GetInt32(reader.GetOrdinal("TotalCount"));
+                if (totalCount > totalPosts)
+                {
+                    totalPosts = totalCount;
+                }
+
+                List<string> images = ParseCsvImageUrls(imageCsv);
+                posts.Add(new FeedPostItem
+                {
+                    Id = postId.ToString(CultureInfo.InvariantCulture),
+                    Name = postTitle,
+                    Price = price,
+                    Location = string.IsNullOrWhiteSpace(city) ? "Jordan" : city,
+                    Area = string.IsNullOrWhiteSpace(area) ? null : area,
+                    Seller = sellerName,
+                    SellerId = userId.ToString(CultureInfo.InvariantCulture),
+                    Category = categoryName,
+                    CategoryId = categoryId.ToString(CultureInfo.InvariantCulture),
+                    Image = images.Count > 0 ? images[0] : string.Empty,
+                    Images = images,
+                    Phone = string.Empty,
+                    Description = postDescription,
+                    CreatedAt = createdAt.ToString("o"),
+                    UpdatedAt = createdAt.ToString("o"),
+                    Views = views,
+                    Status = status
+                });
+            }
+
+            int totalPages = totalPosts > 0
+                ? (int)Math.Ceiling(totalPosts / (double)request.Limit)
+                : 0;
+
+            return new FeedResponse
+            {
+                Success = true,
+                Posts = posts,
+                Pagination = new FeedPagination
+                {
+                    CurrentPage = request.Page,
+                    TotalPages = totalPages,
+                    TotalPosts = totalPosts,
+                    PostsPerPage = request.Limit
+                }
+            };
+        }
+
+        private static List<string> ParseCsvImageUrls(string csv)
+        {
+            if (string.IsNullOrWhiteSpace(csv))
+            {
+                return new List<string>();
+            }
+
+            HashSet<string> uniqueImages = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+            foreach (string value in csv.Split(',', StringSplitOptions.RemoveEmptyEntries))
+            {
+                string normalized = value.Trim();
+                if (!string.IsNullOrWhiteSpace(normalized))
+                {
+                    uniqueImages.Add(normalized);
+                }
+            }
+
+            return new List<string>(uniqueImages);
+        }
+    }
+
+    public sealed class FeedResponse
+    {
+        [JsonPropertyName("success")]
+        public bool Success { get; init; }
+
+        [JsonPropertyName("posts")]
+        public IReadOnlyList<FeedPostItem> Posts { get; init; } = Array.Empty<FeedPostItem>();
+
+        [JsonPropertyName("pagination")]
+        public FeedPagination Pagination { get; init; } = new FeedPagination();
+    }
+
+    public sealed class FeedPagination
+    {
+        [JsonPropertyName("currentPage")]
+        public int CurrentPage { get; init; }
+
+        [JsonPropertyName("totalPages")]
+        public int TotalPages { get; init; }
+
+        [JsonPropertyName("totalPosts")]
+        public int TotalPosts { get; init; }
+
+        [JsonPropertyName("postsPerPage")]
+        public int PostsPerPage { get; init; }
+    }
+
+    public sealed class FeedPostItem
+    {
+        [JsonPropertyName("id")]
+        public string Id { get; init; } = string.Empty;
+
+        [JsonPropertyName("name")]
+        public string Name { get; init; } = string.Empty;
+
+        [JsonPropertyName("price")]
+        public decimal Price { get; init; }
+
+        [JsonPropertyName("location")]
+        public string Location { get; init; } = "Jordan";
+
+        [JsonPropertyName("area")]
+        public string? Area { get; init; }
+
+        [JsonPropertyName("seller")]
+        public string Seller { get; init; } = string.Empty;
+
+        [JsonPropertyName("sellerId")]
+        public string SellerId { get; init; } = string.Empty;
+
+        [JsonPropertyName("category")]
+        public string Category { get; init; } = string.Empty;
+
+        [JsonPropertyName("categoryId")]
+        public string CategoryId { get; init; } = string.Empty;
+
+        [JsonPropertyName("image")]
+        public string Image { get; init; } = string.Empty;
+
+        [JsonPropertyName("images")]
+        public IReadOnlyList<string> Images { get; init; } = Array.Empty<string>();
+
+        [JsonPropertyName("phone")]
+        public string Phone { get; init; } = string.Empty;
+
+        [JsonPropertyName("description")]
+        public string Description { get; init; } = string.Empty;
+
+        [JsonPropertyName("createdAt")]
+        public string CreatedAt { get; init; } = string.Empty;
+
+        [JsonPropertyName("updatedAt")]
+        public string UpdatedAt { get; init; } = string.Empty;
+
+        [JsonPropertyName("views")]
+        public int Views { get; init; }
+
+        [JsonPropertyName("status")]
+        public string Status { get; init; } = "ACTIVE";
+    }
+}
