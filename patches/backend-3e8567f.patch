+using Models;
+using System;
+using System.Collections.Generic;
+using System.Data;
+using System.Linq;
+using System.Security.Claims;
+
+namespace TijarahJoDBAPI.Controllers
+{
+	public partial class UserPostsController
+	{
+		private static readonly DateTime SqlDateTimeMinUtc = new DateTime(1753, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+
+		private static bool IsAdminUser(ClaimsPrincipal user)
+		{
+			var roleClaim = user.FindFirst(ClaimTypes.Role)?.Value;
+			return int.TryParse(roleClaim, out int roleId) && roleId == 1;
+		}
+
+		private static DateTime NormalizeSqlDateTime(DateTime value)
+		{
+			if (value == default || value < SqlDateTimeMinUtc)
+			{
+				return DateTime.UtcNow;
+			}
+
+			return value.Kind switch
+			{
+				DateTimeKind.Utc => value,
+				DateTimeKind.Local => value.ToUniversalTime(),
+				_ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
+			};
+		}
+
+		private static int GetOptionalInt(DataRow row, string columnName, int fallbackValue = 0)
+		{
+			return row.Table.Columns.Contains(columnName) && !row.IsNull(columnName)
+				? Convert.ToInt32(row[columnName])
+				: fallbackValue;
+		}
+
+		private static string? GetOptionalString(DataRow row, string columnName)
+		{
+			return row.Table.Columns.Contains(columnName) && !row.IsNull(columnName)
+				? Convert.ToString(row[columnName])
+				: null;
+		}
+
+		private static PostModel MapPostRow(DataRow row)
+		{
+			return new PostModel
+			(
+				row.Field<int>("PostID"),
+				row.Field<int>("UserID"),
+				row.Field<int>("CategoryID"),
+				row.Field<string>("PostTitle") ?? string.Empty,
+				row.Field<string>("PostDescription") ?? string.Empty,
+				row.Field<decimal?>("Price"),
+				row.Field<int>("Status"),
+				row.Field<DateTime>("CreatedAt"),
+				row.Field<bool>("IsDeleted"),
+				GetOptionalInt(row, "Views"),
+				GetOptionalString(row, "City"),
+				GetOptionalString(row, "Area")
+			);
+		}
+
+		private List<PostModel> MapPostRows(DataTable table, bool includeImageCsv = false)
+		{
+			var posts = new List<PostModel>();
+			foreach (DataRow row in table.Rows)
+			{
+				var postModel = MapPostRow(row);
+				if (!includeImageCsv)
+				{
+					posts.Add(postModel);
+					continue;
+				}
+
+				try
+				{
+					if (row.Table.Columns.Contains("ImageURLs") && !row.IsNull("ImageURLs"))
+					{
+						string? urls = Convert.ToString(row["ImageURLs"]);
+						if (!string.IsNullOrEmpty(urls))
+						{
+							postModel.Images = urls.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
+						}
+					}
+				}
+				catch (Exception ex)
+				{
+					_logger.LogWarning(ex, "Failed to parse image URLs while listing posts.");
+				}
+
+				posts.Add(postModel);
+			}
+
+			return posts;
+		}
+	}
+}
