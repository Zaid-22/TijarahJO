# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Explicitly enforce LF for executable and CI-critical file types.
*.sh text eol=lf
*.sql text eol=lf
*.sha256 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Database scripts directory — always LF.
apps/api/database/** text eol=lf

# Binary files — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.bak binary
