{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "your-production-domain.com",
  "JWT": {
    "Issuer": "https://your-production-domain.com",
    "Audience": "https://your-production-domain.com",
    "Lifetime": 120,
    "SigningKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "FeatureFlags": {
    "EnableRateLimiting": true,
    "EnableHttpLogging": true,
    "EnableHealthChecks": true,
    "EnableInMemoryCaching": true,
    "EnableRedisPresence": true,
    "EnableRedisBackplane": true,
    "RequireRedis": true
  },
  "WebPush": {
    "Enabled": true,
    "Subject": "mailto:security@your-production-domain.com",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "FileStorage": {
    "RootPath": "/var/lib/tijarahjo/uploads",
    "PostImagesPath": "post-images",
    "ChatImagesPath": "chat-images",
    "PublicBasePath": "/uploads",
    "MaxPostImageBytes": 10485760,
    "OptimizeImages": true,
    "ConvertImagesToWebp": true,
    "MaxImageWidth": 2048,
    "MaxImageHeight": 2048,
    "WebpQuality": 75,
    "ThumbnailMaxImageWidth": 640,
    "ThumbnailMaxImageHeight": 640,
    "ThumbnailWebpQuality": 60,
    "AllowedImageExtensions": [".jpg", ".jpeg", ".png", ".webp", ".gif"]
  },
  "GoogleAuth": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "https://your-production-domain.com/api/auth/google/callback",
    "FrontendSuccessUrl": "https://your-frontend-domain.com/",
    "FrontendFailureUrl": "https://your-frontend-domain.com/login",
    "AllowedAudiences": [],
    "AllowedIssuers": [
      "https://accounts.google.com",
      "accounts.google.com"
    ],
    "Prompt": "select_account"
  },
  "PasswordReset": {
    "Enabled": true,
    "CodeLength": 6,
    "CodeLifetimeMinutes": 15,
    "MaxAttempts": 5,
    "RequestCooldownSeconds": 60
  },
  "PasswordResetEmail": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "security@your-production-domain.com",
    "FromName": "TijarahJo Security",
    "LogCodesWhenEmailDisabled": false
  },
  "EmailTwoFactor": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "security@your-production-domain.com",
    "FromName": "TijarahJo Security",
    "LogCodesWhenEmailDisabled": false
  },
  "TwoFactor": {
    "Issuer": "TijarahJo",
    "TimeStepSeconds": 30,
    "AllowedTimeDriftSteps": 1,
    "Digits": 6,
    "LoginChallengeLifetimeSeconds": 300,
    "SecretEncryptionKey": "",
    "ChallengeSigningKey": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
