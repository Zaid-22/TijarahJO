{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JWT": {
    "Issuer": "https://localhost",
    "Audience": "https://localhost",
    "Lifetime": 120,
    "SigningKey": "SET_JWT_SIGNING_KEY_VIA_ENVIRONMENT"
  },
  "ConnectionStrings": {
    "DefaultConnection": "SET_DATABASE_CONNECTION_STRING_VIA_ENVIRONMENT"
  },
  "FeatureFlags": {
    "EnableRateLimiting": true,
    "EnableHttpLogging": true,
    "EnableHealthChecks": true
  },
  "WebPush": {
    "Enabled": false,
    "Subject": "mailto:notifications@tijarahjo.local",
    "PublicKey": "SET_WEB_PUSH_PUBLIC_KEY_VIA_ENVIRONMENT",
    "PrivateKey": "SET_WEB_PUSH_PRIVATE_KEY_VIA_ENVIRONMENT"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
