{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Information"
    }
  },
  "AllowedHosts": "your-production-domain.com",
  "JWT": {
    "Issuer": "https://your-production-domain.com",
    "Audience": "https://your-production-domain.com",
    "Lifetime": 120,
    "SigningKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "FeatureFlags": {
    "EnableRateLimiting": true,
    "EnableHttpLogging": true,
    "EnableHealthChecks": true,
    "EnableInMemoryCaching": true
  },
  "WebPush": {
    "Enabled": true,
    "Subject": "mailto:security@your-production-domain.com",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
