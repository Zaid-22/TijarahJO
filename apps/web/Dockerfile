FROM node:20-alpine AS build
WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./

# Build-time env vars — injected via docker-compose build args
ARG VITE_API_BASE_URL=/api
ARG VITE_GOOGLE_AUTH_ENABLED=true
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_GOOGLE_MAPS_MAP_ID=
ARG VITE_REQUEST_TIMEOUT_MS=10000
ARG VITE_DEFAULT_CITY=Amman
ARG VITE_DEFAULT_PHONE_PREFIX=+962
ARG VITE_HOME_SEARCH_LIMIT=200
ARG VITE_ALL_POSTS_SEARCH_LIMIT=200
ARG VITE_SEARCH_RESULTS_LIMIT=100

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_GOOGLE_AUTH_ENABLED=${VITE_GOOGLE_AUTH_ENABLED} \
    VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY} \
    VITE_GOOGLE_MAPS_MAP_ID=${VITE_GOOGLE_MAPS_MAP_ID} \
    VITE_REQUEST_TIMEOUT_MS=${VITE_REQUEST_TIMEOUT_MS} \
    VITE_DEFAULT_CITY=${VITE_DEFAULT_CITY} \
    VITE_DEFAULT_PHONE_PREFIX=${VITE_DEFAULT_PHONE_PREFIX} \
    VITE_HOME_SEARCH_LIMIT=${VITE_HOME_SEARCH_LIMIT} \
    VITE_ALL_POSTS_SEARCH_LIMIT=${VITE_ALL_POSTS_SEARCH_LIMIT} \
    VITE_SEARCH_RESULTS_LIMIT=${VITE_SEARCH_RESULTS_LIMIT}

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY infra/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80 443
