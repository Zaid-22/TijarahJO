{
  "name": "tijarahjo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:eslint && npm run lint:a11y:icons && npm run lint:a11y:native && npm run lint:styles:inline && npm run lint:styles:tokens && npm run lint:styles:scale && npm run lint:ux:routes",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:a11y:icons": "node tools/check-icon-button-labels.mjs",
    "lint:a11y:native": "node tools/check-native-interactive-a11y.mjs",
    "lint:styles:inline": "node tools/check-inline-style-usage.mjs",
    "lint:styles:tokens": "node tools/check-hardcoded-hex-colors.mjs",
    "lint:styles:scale": "node tools/check-typography-spacing-scale.mjs",
    "lint:ux:routes": "node tools/check-route-ux-workflow.mjs",
    "storybook": "storybook dev --port 6006 --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:check": "node tools/check-storybook-workflow.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "perf:bundle": "npm run build && node tools/check-bundle-budget.mjs",
    "perf:bundle:check": "node tools/check-bundle-budget.mjs",
    "test": "npm run test:all",
    "test:prep": "tsc -p tsconfig.unit.json && printf '{\"type\":\"commonjs\"}\\n' > .unit-dist/package.json",
    "test:unit": "npm run test:prep && node --test tests/unit/*.test.cjs",
    "test:integration": "npm run test:prep && node --test tests/integration/*.test.cjs",
    "test:policy:e2e": "npm run test:prep && node --test tests/e2e/*.test.cjs",
    "test:e2e:browser": "node tools/run-playwright-e2e.mjs",
    "test:e2e:backend-live": "VITE_API_BASE_URL=http://localhost:5033/api E2E_FRONTEND_HOST=localhost E2E_FRONTEND_BASE_URL=http://localhost:4173 E2E_BACKEND_LIVE=1 PW_BYPASS_CSP=0 npx playwright test --config=playwright.config.cjs --project=chromium tests/browser-e2e/backend-live.spec.cjs",
    "test:e2e": "npm run test:e2e:browser",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:policy:e2e",
    "test:release": "npm run test:all && npm run test:e2e:browser"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0",
    "sonner": "^1.2.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.53.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
