{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": false,
    "outDir": ".unit-dist",
    "noEmit": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/services/api/posts/mappers.ts",
    "src/services/api/posts/types.ts",
    "src/services/api/normalizers.ts",
    "src/services/api/schemas/authSchema.ts",
    "src/services/api/schemas/categorySchema.ts",
    "src/services/api/schemas/chatSchema.ts",
    "src/services/api/schemas/userSchema.ts",
    "src/services/api/shared.ts",
    "src/services/api/chatNormalization.ts",
    "src/utils/idValidation.ts",
    "src/contexts/authRuntimePolicy.ts"
  ]
}
