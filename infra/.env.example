# -----------------------------------------------------------------------------
# TijarahJo Production Environment Template
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in real values BEFORE running
# docker compose -f docker-compose.production.yml up
#
# NEVER commit the .env file — it is gitignored.
# NEVER put real secrets in this template.
# -----------------------------------------------------------------------------

# 1. Host & Domains
FRONTEND_URL=https://tijarahjo.online
CORS_ALLOWED_ORIGINS=https://tijarahjo.online,https://www.tijarahjo.online
ALLOWED_HOSTS=tijarahjo.online,www.tijarahjo.online

# 2. Database Configuration (MSSQL Server)
#    - SA password: min 8 chars, must include upper, lower, digit, and symbol
#    - App password: used by the API service to connect (least-privilege user)
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_SA_PASSWORD
DB_APP_LOGIN=tijarahjo_app
DB_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# 3. Redis Password
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# 4. Security Keys (JWT & 2FA Tokens)
#    - JWT signing key: min 32 characters, use a cryptographically random string
#    - 2FA keys: min 32 characters each, use cryptographically random strings
#    Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_MIN_32_CHAR_RANDOM_STRING
JWT_ISSUER=https://tijarahjo.online
JWT_AUDIENCE=https://tijarahjo.online

# Two-Factor Authentication Secrets
TwoFactor__SecretEncryptionKey=CHANGE_ME_MIN_32_CHAR_RANDOM_STRING
TwoFactor__ChallengeSigningKey=CHANGE_ME_MIN_32_CHAR_RANDOM_STRING

# 5. Google OAuth Credentials
#    Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_AUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=GOCSPX-YOUR_GOOGLE_CLIENT_SECRET

# 6. Gemini & YouTube API Keys
#    Obtain from: https://aistudio.google.com/apikey (Gemini)
#                 https://console.cloud.google.com/apis/credentials (YouTube)
Gemini__ApiKey=CHANGE_ME_GEMINI_API_KEY
YouTube__ApiKey=CHANGE_ME_YOUTUBE_API_KEY
YouTube__Referer=https://tijarahjo.online/

# 7. Frontend Build Args (Vite)
#    Google Maps key: restrict by HTTP referrer to tijarahjo.online/*
#    Obtain from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY
