# HTTP-only config for deployment behind an external reverse proxy (e.g. Nginx Proxy Manager).
# The edge proxy terminates TLS and forwards plain HTTP to this container on port 80.
# Do NOT redirect to HTTPS here — that causes an infinite redirect loop.

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

limit_req_zone $binary_remote_addr zone=api_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=api_auth:10m    rate=5r/s;

# Canonical bare domain — redirect www at the app layer (optional if NPM also does this)
server {
    listen 80;
    server_name www.tijarahjo.online;

    return 301 https://tijarahjo.online$request_uri;
}

server {
    listen 80;
    server_name tijarahjo.online;

    server_tokens off;

    # Security headers (HSTS is set at the edge proxy when it terminates TLS)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss text/javascript image/svg+xml;

    root /usr/share/nginx/html;
    index index.html;

    # Do not fallback to index.html for missing static assets under /assets/
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        client_max_body_size 15M;
        # burst=120: allow up to 120 queued requests above the 30r/s rate.
        # delay=30: process the first 30 excess requests immediately;
        # the remainder are delayed (not rejected) until capacity frees up.
        # This handles legitimate page-load bursts without 429-ing real users.
        limit_req zone=api_general burst=120 delay=30;

        proxy_pass http://api:5033/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /api/v1/auth/ {
        client_max_body_size 1M;
        limit_req zone=api_auth burst=10 nodelay;

        proxy_pass http://api:5033/api/v1/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /chatHub {
        proxy_pass http://api:5033/chatHub;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 600s;
    }

    location /uploads/ {
        proxy_pass http://api:5033/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
