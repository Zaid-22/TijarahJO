# -----------------------------------------------------------------------------
# TijarahJo local development environment template
# -----------------------------------------------------------------------------
# Backend runtime
DB_HOST=localhost,1433
DB_NAME=TijarahJoDB
DB_USER=sa
DB_PASSWORD=CHANGE_ME
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SIGNING_KEY=CHANGE_ME_MIN_32_CHAR_SECRET
DB_RUNTIME_PRINCIPAL=app
DB_APP_LOGIN=tijarahjo_app
DB_APP_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
APPLY_DEV_SEEDS=false

# Google OAuth (optional)
GOOGLE_AUTH_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5033/api/v1/auth/google/callback
GOOGLE_AUTH_FRONTEND_SUCCESS_URL=http://localhost:5173/
GOOGLE_AUTH_FRONTEND_FAILURE_URL=http://localhost:5173/login
# Optional comma-separated overrides (defaults are usually fine)
# GOOGLE_AUTH_ALLOWED_AUDIENCES=
# GOOGLE_AUTH_ALLOWED_ISSUERS=https://accounts.google.com,accounts.google.com

# Password reset / email verification (optional)
PasswordReset__Enabled=true
PasswordReset__CodeLength=6
PasswordReset__CodeLifetimeMinutes=15
PasswordReset__MaxAttempts=5
PasswordReset__RequestCooldownSeconds=60
PasswordResetEmail__Enabled=false
PasswordResetEmail__Host=
PasswordResetEmail__Port=587
PasswordResetEmail__EnableSsl=true
PasswordResetEmail__Username=
PasswordResetEmail__Password=
PasswordResetEmail__FromAddress=no-reply@tijarahjo.local
PasswordResetEmail__FromName=TijarahJo Security
PasswordResetEmail__LogCodesWhenEmailDisabled=true

# Email Two-Factor Authentication (optional)
EmailTwoFactor__Enabled=false
EmailTwoFactor__ResendApiKey=
EmailTwoFactor__FromAddress=no-reply@tijarahjo.local
EmailTwoFactor__FromName="TijarahJo Security"
EmailTwoFactor__LogCodesWhenEmailDisabled=true

# TOTP / Two-Factor local secrets (required outside development)
TwoFactor__SecretEncryptionKey=CHANGE_ME_MIN_32_CHAR_SECRET
TwoFactor__ChallengeSigningKey=CHANGE_ME_MIN_32_CHAR_SECRET

# Optional explicit connection string (overrides DB_HOST/DB_NAME/DB_USER/DB_PASSWORD)
# DATABASE_CONNECTION_STRING=Data Source=localhost,1433;Database=TijarahJoDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True;

# Frontend runtime
VITE_API_BASE_URL=http://localhost:5033/api/v1
VITE_GOOGLE_AUTH_ENABLED=false
VITE_REQUEST_TIMEOUT_MS=10000
VITE_DEFAULT_CITY=Amman
VITE_DEFAULT_PHONE_PREFIX=+962
VITE_HOME_SEARCH_LIMIT=200
VITE_ALL_POSTS_SEARCH_LIMIT=200
VITE_SEARCH_RESULTS_LIMIT=100
# Optional CSP override for production builds:
# - Space/comma-separated additional connect-src origins.
VITE_CSP_CONNECT_SRC_EXTRA=

# Optional debug flags (set to true only while debugging)
VITE_DEBUG_API=false
VITE_DEBUG_AUTH=false
VITE_DEBUG_LOGIN=false
VITE_DEBUG_PROFILE=false
VITE_DEBUG_CHAT=false

# Gemini AI (Required for Post Comparison)
Gemini__ApiKey=
YouTube__ApiKey=
